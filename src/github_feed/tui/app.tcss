Screen {
    layout: vertical;
}

Header {
    dock: top;
}

Footer {
    dock: bottom;
}

#home-layout,
#starred-layout,
#releases-layout {
    padding: 1 2;
    height: 1fr;
}

#home-title {
    content-align: center middle;
    height: 3;
    text-style: bold;
}

#home-metadata {
    border: round $boost;
    padding: 1 2;
    margin-bottom: 1;
}

#home-actions {
    align: center middle;
    height: auto;
}

#home-actions Button {
    margin-right: 1;
}

.toolbar {
    height: auto;
    margin-bottom: 1;
}

.toolbar Button {
    margin-right: 1;
}

#starred-status,
#release-status {
    margin-bottom: 1;
}

#starred-table {
    height: 1fr;
}

#release-content {
    height: 1fr;
}

#release-list {
    width: 48;
    border: round $boost;
    margin-right: 1;
}

#release-notes {
    width: 1fr;
    border: round $boost;
    padding: 1 2;
    overflow-y: auto;
}

.release-item {
    padding: 0 1;
}
